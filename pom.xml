<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.lender</groupId>
    <artifactId>lender-assistant</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>lender-assistant</name>
    <description>融资智能工作台 - RAG 问答 / 字段映射抽取 / 适配层代码生成</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <!-- Testcontainers 2.x：1.21 在 Windows 上探测 Docker named pipe 恒失败（File.exists 判断），
             2.x 换用新的 Docker 客户端探测链路。坐标在 2.x 已改成 testcontainers-* 前缀，Boot BOM 不再管 -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- 默认排除 docker 标签：无 Docker 的机器上 mvn test 只跑纯单测（见 §9 测试分层） -->
        <test.excluded.groups>docker</test.excluded.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 显式覆盖 Spring Boot BOM 管理的 Testcontainers 1.21.x：
                 本项目 BOM 优先于父 POM，避免 2.x 模块被传递依赖拉回 1.x -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- AOP：仅用于 ControllerLogAspect 打印控制器进出参/耗时。
             它自带 aspectjweaver 并触发 Spring Boot AopAutoConfiguration 开启 @AspectJ 代理，
             因此只加这一个 starter 即可，不需要额外的 @EnableAspectJAutoProxy。
             注意：这不改变"Resilience4j 用纯库、不用注解 AOP"的口径（§0.1）——
             AOP 只管 controller 的日志切面，韧性仍走编程式 decorateSupplier -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Actuator + Micrometer Tracing：为日志链路生成 traceId/spanId。
             actuator 提供 Observation 自动装配入口（HTTP 请求被观测并转成 trace），
             自带的 /actuator/* 端点对本项目无价值——项目有自研 /health 探针（ops/），
             故 application.yml 里 management.endpoints.enabled-by-default=false 全关，
             只保留装配机制。注意：starter-security 未引入，/actuator 关闭后无额外暴露面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Micrometer Tracing 的 Brave 桥接：请求进来时生成 32 位 traceId + 16 位 spanId
             塞进 MDC，StructuredLogEncoder（logstash JSON）自动平铺成日志字段，
             Kibana 按 traceId 即可串起一次调用的全部日志。选 brave 而非 otel 桥：
             纯本地生成、不外发数据、依赖更小；将来接 Zipkin/OTel Collector 时再换 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <!-- 对话模型：走 OpenAI 兼容协议（DeepSeek/Kimi/通义/GLM 等均支持）。
             选它而非厂商专属 starter，是为了"只改 base-url + model + key 就能切换模型"，
             业务代码与策略实现无需改动。启动不依赖 key，调用时才需要 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- JDBC + PostgreSQL：doc_chunk 入库与混合检索。
             不用 JPA：本项目的 SQL 都围绕 pgvector 特有语法（HNSW/trigram），
             JdbcTemplate 写原生 SQL 反而更直观可控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- MyBatis：统一数据访问口径（AGENTS.md §6）。
             不引 MyBatis-Plus（谓词构造器会诱导把业务判断写进数据层）；
             版本 3.0.5 对应 MyBatis 3.5.x，兼容 Spring Boot 3.5 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 只取 BCrypt 口令编码器。不引 spring-boot-starter-security：
             全家桶的自动配置会改掉 /health、SSE 与既有 curl 脚本的对外行为，
             而本期用不到它的方法级授权/CSRF 等能力（取舍见 ADR-0019） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Apache POI：解析资方接口文档（.docx）。Tika 暂不引入——
             当前没有 PDF 场景，Tika 全家桶 20MB+，需要时再加 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

        <!-- Resilience4j 纯库（模型调用韧性）：不用 spring-boot3 starter 的注解 AOP——
             编程式 decorateSupplier 一个纯 JUnit 测试就能驱动熔断状态机，
             也符合"AI 代码必须看得懂"的红线。超时不在它管：对话模型流自身
             .timeout(60s) + SseEmitter 120s 已兜底 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>2.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 集成测试：真实 PostgreSQL(pgvector) 验证 Mapper XML 里的 SQL。
             版本由上方 testcontainers-bom 管理；2.x 坐标带 testcontainers- 前缀 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 按 JUnit tag 隔离集成测试：默认不跑 @Tag("docker")，
                         代价是 mvn test 在无 Docker 的机器上仍然全绿（§9） -->
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration-tests</id>
            <properties>
                <!-- 显式跑集成测试：mvn test -Pintegration-tests
                     容器不可用时由 @Testcontainers(disabledWithoutDocker = true) 跳过，不判失败 -->
                <test.excluded.groups>none</test.excluded.groups>
            </properties>
        </profile>
    </profiles>
</project>
