<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 落盘目录：application.yml logging.file.path（默认 E:/project/logs），LOG_PATH 环境变量可整体覆盖。
         容器内由 compose 设 LOG_PATH=/app/logs 挂回宿主 ./logs，本地与生产不区分 profile。 -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="./logs"/>

    <!-- 控制台统一格式：与 ControllerLogAspect 的「接口调用/返回/耗时」同一口径，grep 时间即可串起一次请求 -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全量日志：当天固定名 lender-assistant.log，跨天滚动归档为 lender-assistant-YYYY-MM-DD.log；
         文件用 Logstash JSON 格式（Spring Boot 内置 StructuredLogEncoder，零依赖），供 Filebeat/ELK 直接采集；
         TimeBasedRollingPolicy 未设 maxHistory = 归档永不清理（logback 语义：maxHistory 为 0/未设时不装配清理器），稳定后再启用。 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/lender-assistant.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/lender-assistant-%d{yyyy-MM-dd}.log</fileNamePattern>
        </rollingPolicy>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>logstash</format>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 只收 ERROR：线上排查故障时免于在混合日志里翻；主日志仍保留 ERROR 行，保证时间线完整。
         同样按天滚动，格式与主日志一致（JSON，level 字段可直接过滤）。 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error-%d{yyyy-MM-dd}.log</fileNamePattern>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>logstash</format>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
