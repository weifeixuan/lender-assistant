    {"id": 19, "type": "RULE", "question": "瑞金租赁异步通知的重试策略是什么？",         "docId": "ruijin_api_v1",        "mustContain": ["重试 5 次", "最多重试"], "note": "异步通知规则"},
    {"id": 20, "type": "NEGATIVE", "question": "华信银行的逾期罚息利率是多少？",        "docId": null,                   "mustContain": [],                  "note": "资料中不存在，recall 不统计；语义验收看模型是否答'资料中未提及'"}
