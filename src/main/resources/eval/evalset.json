    {"id": 11, "type": "FACT", "question": "华信银行交易查询接口支持按什么条件查询？",    "docId": "huaxin_corp_api_v1",   "mustContain": ["outBizNo", "hxSeqNo"], "note": "查询条件"},
    {"id": 12, "type": "RULE", "question": "交易状态是 PROCESSING 时该怎么处理？",      "docId": "huaxin_corp_api_v1",   "mustContain": ["不得直接作为失败"], "note": "状态处理规则"},
    {"id": 13, "type": "RULE", "question": "机构发现日末文件金额不一致时多久内反馈？",    "docId": "huaxin_eod_format_v1", "mustContain": ["T+1", "18:00"],    "note": "差错处理时限"},
