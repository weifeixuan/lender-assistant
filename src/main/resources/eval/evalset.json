    {"id": 7,  "type": "FACT", "question": "华信银行代付接口的手续费承担字段是什么？",   "docId": "huaxin_corp_api_v1",   "mustContain": ["feeFlag"],         "note": "字段名英文原文"},
    {"id": 8,  "type": "RULE", "question": "华信银行请求头的时间戳格式是什么？",         "docId": "huaxin_corp_api_v1",   "mustContain": ["yyyyMMddHHmmss"],  "note": "请求头字段表"},
