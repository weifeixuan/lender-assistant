    {"id": 3,  "type": "RULE", "question": "日末文件的命名规则是什么？",               "docId": "huaxin_eod_format_v1", "mustContain": ["机构编号_yyyyMMdd", "文件类型缩写"], "note": "文件命名格式串"},
